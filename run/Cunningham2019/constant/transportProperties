FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (metal gas);

metal
{
    //transportModel  Newtonian;  //trueArrheniusNewtonian
    //nu              2.14e-06;   // Wunderlich: nu = 11.4e-07, mu = 4.76e-3
    transportModel  trueArrheniusNewtonian;
    trueArrhenius<Newtonian>Coeffs
    {
        alpha       3221;
        Talpha      1903;
    };
    nu   9.1e-7; //Russian work
    rho             3800;       // Mills Ti64 at 1650

    quasiIncompressible false;
    momentumRedistribution false;

    rhoSolid        3800;
    betaLiquid         0;

    tauCorr         1e10;
}

gas
{
    transportModel  Newtonian;

    nu              2.76e-4; // Fictious gas
    rho             2.9;     // Fictious gas
}

sigma
{
    type            temperatureDependent;
    sigma           polynomial
    (
        (1.5                         0)
        (-1.e-4                      1)
   );
}

  surfaceTensionForceModel fitParaboloid;
  accelerationForceModel gravity;
  deltaFunctionModel alphaCSF;


beta            beta            [ K^-1 ]          0.0;
mushyCoeff      mushyCoeff      [ kg/m^3/s ]     5e+8;
qMushyCoeff     qMushyCoeff                     1e-15;

